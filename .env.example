TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_chat_id
# Optional second bot: “sure” matches (score > high_confidence_score_gt, or title substring + score > high_confidence_title_min_score; see config YAML).
# TELEGRAM_HIGH_CONFIDENCE_BOT_TOKEN=
# TELEGRAM_HIGH_CONFIDENCE_CHAT_ID=
VERTEX_PROJECT_ID=your_gcp_project_id
VERTEX_LOCATION=global
VERTEX_GCS_BUCKET=your_existing_gcs_bucket_name
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dbname

# eBay Browse API (only if you use source: ebay in config/config.yaml)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope

# Facebook Marketplace (source: facebook) — use at least one session method:
#
# A) Persistent profile (recommended): folder Playwright reuses for cookies
# FACEBOOK_BROWSER_USER_DATA_DIR=C:\Users\YOU\fb_playwright_profile
# One-time login: python scripts/facebook_open_profile.py (same env var set)
#
# B) storage_state.json from a logged-in export (keep private; do not commit)
# FACEBOOK_STORAGE_STATE_PATH=C:\path\to\fb_storage_state.json
#
# C) If redirects / empty SERP persist, try real Chrome and/or visible window:
# FACEBOOK_USE_SYSTEM_CHROME=1
# FACEBOOK_HEADFUL=1
#
# Debug: log marketplace-related XHR/fetch URLs and extracted id counts (no response bodies):
# FACEBOOK_TRACE_RESPONSES=1
